  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API Requests by User Role",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (role) (rate(log_classifier_requests_by_role_total[5m]))",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Classifications by Subscription Tier",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tier) (rate(log_classifier_classifications_by_tier_total[5m]))",
          "legendFormat": "Tier: {{tier}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Authentication Events (Logins, Refreshes, Failures)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (event_type, status) (log_classifier_auth_events_total)",
          "legendFormat": "{{event_type}} ({{status}})",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Active Subscriptions by Tier",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "log_classifier_active_subscriptions_gauge",
          "legendFormat": "{{tier}}",
          "refId": "D"
        }
      ]
    },
    {
      "title": "Overall Classification Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 Latency",
          "refId": "E"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["log-classifier", "observability", "production"],
  "time": { "from": "now-6h", "to": "now" },

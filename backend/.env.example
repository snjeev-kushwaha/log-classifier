# --- Groq / LLM ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=deepseek-r1-distill-llama-70b
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=2

# --- Environment ---
ENVIRONMENT=development   # set to "production" to enforce API_KEYS being set

# --- Database ---
DATABASE_URL=sqlite:///./log_classifier.db
# Production: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/log_classifier

# --- Routing thresholds ---
ML_CONFIDENCE_THRESHOLD=0.75
LLM_FALLBACK_CONFIDENCE_THRESHOLD=0.6
# Comma-separated `source` values that always route straight to the LLM,
# bypassing regex/ML (e.g. a legacy system with no clean training data):
LLM_ONLY_SOURCES=LegacyCRM,ThirdPartyBillingSystem

# --- Security ---
# Comma-separated list of accepted API keys. REQUIRED when ENVIRONMENT=production.
API_KEYS=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
BATCH_RATE_LIMIT_PER_MINUTE=5
MAX_BATCH_ROWS=5000

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Observability ---
LOG_LEVEL=INFO
JSON_LOGS=true

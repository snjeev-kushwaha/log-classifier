# --- Groq / LLM ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=deepseek-r1-distill-llama-70b
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=2

# --- Environment ---
ENVIRONMENT=development   # set to "production" to enforce API_KEYS being set

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/mydatabase

# --- Routing thresholds ---
ML_CONFIDENCE_THRESHOLD=0.75
LLM_FALLBACK_CONFIDENCE_THRESHOLD=0.6
# Comma-separated `source` values that always route straight to the LLM,
# bypassing regex/ML (e.g. a legacy system with no clean training data):
LLM_ONLY_SOURCES=LegacyCRM,ThirdPartyBillingSystem

# --- Security & Auth ---
# Static API keys (optional fallback / machine access)
API_KEYS=
# JWT & Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
DAILY_USER_QUOTA=1000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
BATCH_RATE_LIMIT_PER_MINUTE=5
MAX_BATCH_ROWS=5000

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Observability ---
LOG_LEVEL=INFO
JSON_LOGS=true

# --- OAuth2 (Google & GitHub) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# --- Email & Credentials Dispatch (SMTP / Nodemailer equivalent) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and generate an App Password in Google Account security
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@logclassifier.io


# ==============================================================================
# Git Ignore Configuration for Log Classifier Project (Backend & Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials, & Environment Variables (CRITICAL)
# ------------------------------------------------------------------------------
# Environment files across root, backend, and frontend
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore example / template environment files
!.env.example
!.env.template
!.env.*.example

# API Keys, Tokens, & Secret Dumps
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
*.id_rsa
*.token
*.credentials
secrets/
private/
*secret*.json
credentials.json
service-account*.json
*service_account*.json

# Cloud provider credentials
.aws/
.gcp/
.azure/

# ------------------------------------------------------------------------------
# Backend (Python / FastAPI / ML / SQLite)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite & Local Databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
log_classifier.db

# Machine Learning Models & Serialized Artifacts
artifacts/
*.joblib
*.pkl
*.pickle
models/*.joblib
models/*.pkl

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Backend Logs
*.log
logs/

# ------------------------------------------------------------------------------
# Frontend (Node / Vite / React / Playwright)
# ------------------------------------------------------------------------------
# Node dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
out/

# Vite / bundler caches
.vite/
.cache/
.parcel-cache/

# Test & E2E Artifacts (Playwright / Vitest)
playwright-report/
test-results/
blob-report/
playwright/.cache/
coverage/

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Docker & Local Overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
.docker/

# ------------------------------------------------------------------------------
# IDE & Operating System Files
# ------------------------------------------------------------------------------
# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors (VS Code, JetBrains, vim, etc.)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.swp
*.swo
*~
.history/
